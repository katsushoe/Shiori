<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <VersionPrefix>2.3.8.0</VersionPrefix>
    <AssemblyVersion>2.3.8.0</AssemblyVersion>
    <FileVersion>2.3.8.0</FileVersion>
    <InformationalVersion>2.3.8.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Akatsukisoft</Company>
    <Authors>Akatsukisoft</Authors>
    <Product>Shiori</Product>
    <Copyright>Copyright © Akatsukisoft</Copyright>
  </PropertyGroup>
</Project>
